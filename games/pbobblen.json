    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "round": {
    "addr": "0x102271",
    "type": "u8",
    "add": 1,
    "note": "round, 0-based in RAM (FinalBurn Neo cheats, Select Next Round Now!), to be confirmed in game"
   },
   "vs_mode": {
    "addr": "0x101079",
    "type": "u8",
    "note": "game mode, 0 one player, 1 VS between two players (RetroAchievements code notes, from tools/ra_notes.py; captures taken in a VS game read 1), it stays 1 after the VS demo"
   },
   "wins": {
    "addr": "0x102275",
    "type": "u8",
    "note": "VS, matches won by player 1 as the game shows them, learned on a cabinet with learn.bat (1.31: 0-0, 0-2 then 1-2, each typed as the game showed it). The game sets it back to 0 when a human then beats the computer. 0x102297, read until then, did not follow it. The other bytes that followed it in those captures are set aside",
    "not_learned": ["0x101477", "0x1025DB", "0x1056DA", "0x108235"]
   },
   "wins_p2": {
    "addr": "0x102277",
    "type": "u8",
    "note": "VS, matches won by player 2 as the game shows them, learned on a cabinet with learn.bat (1.31, the same captures), two bytes after player 1's. The other bytes that followed it are set aside",
    "not_learned": ["0x105ACF", "0x106DFF"]
   },
   "bubble": {
    "addr": "0x10821F",
    "type": "u8",
    "note": "player 1 bubble in the launcher, 0 blue, 1 red, 2 yellow, 3 green, 4 purple, 5 orange, 6 black, 7 grey (FinalBurn Neo cheats)"
   },
   "bubble_next": {
    "addr": "0x10823D",
    "type": "u8",
    "note": "player 1 next bubble, same colors (FinalBurn Neo cheats)"
   },
   "bubble_p2": {
    "addr": "0x1082BB",
    "type": "u8",
    "note": "player 2 bubble in the launcher (FinalBurn Neo cheats)"
   },
   "bubble_next_p2": {
    "addr": "0x1082D9",
    "type": "u8",
    "note": "player 2 next bubble (FinalBurn Neo cheats)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
