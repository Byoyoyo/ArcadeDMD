{
 "title": "Power Spikes II",
 "match": [
  {
   "system": [
    "pspikes2"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "pspikes2"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "time_min": {
    "addr": "0x102B4D",
    "type": "u8",
    "note": "minutes of the game time (FinalBurn Neo cheats, Infinite Game Time, to be confirmed in game)"
   },
   "time_sec": {
    "addr": "0x102B4B",
    "type": "u8",
    "note": "seconds of the game time (FinalBurn Neo cheats, Infinite Game Time, to be confirmed in game)"
   },
   "power": {
    "addr": "0x102CD9",
    "type": "u8",
    "max": 48,
    "note": "player 1 power, 48 at most (FinalBurn Neo cheats, Always have Max Power PL1)"
   },
   "power_p2": {
    "addr": "0x102CDB",
    "type": "u8",
    "max": 48,
    "note": "player 2 power (FinalBurn Neo cheats, Always have Max Power PL2)"
   },
   "energy": {
    "addr": "0x1018F9",
    "type": "u8",
    "max": 96,
    "note": "player 1 energy (FinalBurn Neo cheats, Always Full Energy PL1)"
   },
   "energy_p2": {
    "addr": "0x1018FB",
    "type": "u8",
    "max": 96,
    "note": "player 2 energy (FinalBurn Neo cheats, Always Full Energy PL2)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   },
   "bios_mvs": {
    "addr": "0x10FD82",
    "type": "u8",
    "note": "BIOS_MVS_FLAG: 0 home console (AES, no coins), otherwise arcade (MVS)"
   }
  }
 },
