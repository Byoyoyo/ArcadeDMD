{
 "title": "Football Frenzy",
 "match": [
  {
   "system": [
    "fbfrenzy"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "fbfrenzy"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "0x104368",
    "type": "bcd",
    "bytes": 2,
    "note": "points of player 1's team (FinalBurn Neo cheats, Score always PL1)"
   },
   "score_p2": {
    "addr": "0x104468",
    "type": "bcd",
    "bytes": 2,
    "note": "points of the other team (FinalBurn Neo cheats, Score always PL2)"
   },
   "time_min": {
    "addr": "0x100AD8",
    "type": "bcd",
    "bytes": 1,
    "note": "minutes of the quarter (FinalBurn Neo cheats, Infinite Time, to be confirmed in game)"
   },
   "time_sec": {
    "addr": "0x100AD9",
    "type": "bcd",
    "bytes": 1,
    "note": "seconds of the quarter (FinalBurn Neo cheats, Infinite Time, to be confirmed in game)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   },
   "bios_mvs": {
    "addr": "0x10FD82",
    "type": "u8",
    "note": "BIOS_MVS_FLAG: 0 home console (AES, no coins), otherwise arcade (MVS)"
   }
  }
 },
 "hd": {
  "scene": "fbfrenzy"
 },
 "demo": {
  "attract": true,
  "credits": 0,
  "p1_mode": 1,
  "p2_mode": 0,
  "score": 0,
  "score_p2": 0,
  "time_min": 1,
  "time_sec": 12,
  "sim": {
   "score": {
    "cycle": [
     0,
     0,
     7,
     7,
     14
    ],
    "every": 8.0,
    "start": 8.0
   },
   "score_p2": {
    "cycle": [
     0,
     0,
     0,
     7,
     7
    ],
    "every": 10.0,
    "start": 10.0
   },
   "time_sec": {
    "count": [
     0,
     59,
     -1
    ],
    "every": 1.0,
    "start": 1.0
   },
   "time_min": {
    "cycle": [
     1,
     0
    ],
    "every": 60.0,
    "start": 13.0
   }
  }
 },
