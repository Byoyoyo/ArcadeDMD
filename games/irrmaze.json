{
 "title": "The Irritating Maze",
 "match": [
  {
   "system": [
    "irrmaze"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "irrmaze"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "time_sec": {
    "addr": "0x10A857",
    "type": "u8",
    "note": "seconds of TIME (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Time writes 99)"
   },
   "time_tenths": {
    "addr": "0x10A859",
    "type": "u8",
    "note": "tenths of TIME (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Time writes 9, to be confirmed in game)"
   },
   "lives": {
    "addr": "0x10808F",
    "type": "u8",
    "note": "lives (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Lives)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
 "hd": {
  "scene": "irrmaze"
 },
 "demo": {
  "attract": true,
  "credits": 0,
  "p1_mode": 1,
  "p2_mode": 0,
  "time_sec": 60,
  "time_tenths": 0,
  "lives": 3,
  "sim": {
   "time_sec": {
    "count": [
     0,
     60,
     -1
    ],
    "every": 1.0,
    "start": 1.0
   },
   "time_tenths": {
    "count": [
     0,
     9,
     -1
    ],
    "every": 0.1,
    "start": 0.1
   },
   "lives": {
    "cycle": [
     3,
     3,
     2,
     2,
     1,
     3
    ],
    "every": 6.0,
    "start": 7.0
   }
  }
 },
