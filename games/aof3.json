   "_in_p1": {
    "addr": "0x10FD96",
    "type": "u8",
    "fast": true,
    "note": "BIOS_P1CURRENT: the stick and buttons of player 1 (bit 0 up, 1 down, 2 left, 3 right, 4 A, 5 B, 6 C, 7 D), read at every frame (\"fast\") for the moves recognised at the stick (1.39); read the other way round if up and down show together"
   },
   "_in_p2": {
    "addr": "0x10FD9C",
    "type": "u8",
    "fast": true,
    "note": "BIOS_P2CURRENT: the stick and buttons of player 2, same bits"
   },
