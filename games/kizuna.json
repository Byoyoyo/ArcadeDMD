   "backdrop": {
    "addr": "0x109659",
    "type": "u8",
    "note": "the stage (the robot's recordings of 2026-11-15 and 16: one value through a fight, the same backdrop each time it comes back; 16 to 18 between the fights). Picks the HD theme in \"hd\": \"stages\""
   },
   "time": {
    "addr": "0x10892A",
    "type": "bcd",
    "bytes": 1,
    "note": "timer (BCD)"
   },
   "_time_sub": {
    "addr": "0x10892D",
    "type": "u8",
    "start": 120,
