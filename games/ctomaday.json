{
 "title": "Captain Tomaday",
 "match": [
  {
   "system": [
    "ctomaday"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "ctomaday"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "lives": {
    "addr": "0x10137D",
    "type": "u8",
    "note": "player 1 lives (FinalBurn Neo cheats, Infinite Lives PL1)"
   },
   "power": {
    "addr": "0x104201",
    "type": "u8",
    "max": 5,
    "note": "player 1 right arm power, 5 at most (FinalBurn Neo cheats, Maximum Power Right Arm PL1)"
   },
   "power_l": {
    "addr": "0x1041AB",
    "type": "u8",
    "max": 5,
    "note": "player 1 left arm power, 5 at most (FinalBurn Neo cheats, Maximum Power Left Arm PL1)"
   },
   "lives_p2": {
    "addr": "0x101399",
    "type": "u8",
    "note": "player 2 lives (FinalBurn Neo cheats, Infinite Lives PL2)"
   },
   "power_p2": {
    "addr": "0x1043F1",
    "type": "u8",
    "max": 5,
    "note": "player 2 right arm power (FinalBurn Neo cheats)"
   },
   "power_l_p2": {
    "addr": "0x10439B",
    "type": "u8",
    "max": 5,
    "note": "player 2 left arm power (FinalBurn Neo cheats)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
 "hd": {
  "scene": "ctomaday"
 },
 "demo": {
  "attract": true,
  "credits": 0,
  "p1_mode": 1,
  "p2_mode": 0,
  "score": 0,
  "lives": 3,
  "power": 1,
  "power_l": 1,
  "sim": {
   "power": {
    "count": [
     1,
     5,
     1
    ],
    "every": 5.0,
    "start": 5.0
   },
   "power_l": {
    "count": [
     1,
     5,
     1
    ],
    "every": 6.0,
    "start": 8.0
   },
   "lives": {
    "cycle": [
     3,
     3,
     2,
     2,
     3
    ],
    "every": 10.0,
    "start": 12.0
   }
  }
 },
