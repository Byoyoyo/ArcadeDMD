{
 "title": "Jockey Grand Prix",
 "match": [
  {
   "system": [
    "jockeygp",
    "jockeygpa"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "jockeygp",
   "jockeygpa"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   }
  }
 },
 "hd": {
  "scene": "jockeygp"
 },
 "demo": {
  "attract": true,
  "credits": 0,
  "p1_mode": 1,
  "p2_mode": 0,
  "sim": {}
 },
 "scene": {
  "layers": [
   {
    "type": "rect",
    "x": 0,
    "y": 11,
    "w": 128,
    "h": 21,
    "color": "#a07848",
    "when": {
     "not": {
      "all": [
       {
        "has": "p1_mode"
       },
       {
        "not": {
         "var": "p1_mode",
         "in": [
          1,
          2
         ]
        }
       },
       {
        "not": {
         "var": "p2_mode",
         "in": [
          1,
          2
         ]
        }
       }
      ]
     }
    }
   },
   {
    "type": "rect",
    "x": 0,
    "y": 13,
    "w": 128,
    "h": 1,
    "color": "#40a060",
    "when": {
     "not": {
      "all": [
       {
        "has": "p1_mode"
       },
       {
        "not": {
         "var": "p1_mode",
         "in": [
          1,
          2
         ]
        }
       },
       {
        "not": {
         "var": "p2_mode",
         "in": [
          1,
          2
         ]
        }
       }
      ]
     }
    }
