   },
   "_p1_dir": {
    "addr": "0x10100D",
    "type": "u8",
    "note": "the side player 1's fighter faces: a motion of the stick reads the other way round when the fighter faces left (1.39). What the byte holds when a round starts is learnt as facing right. From the FBNeo training mode; the robot's recording of 2026-11-16 reads 0 and 1 at 19 round starts out of 24 and opposite values 93% of the fights"
   },
   "_p2_dir": {
    "addr": "0x101123",
    "type": "u8",
    "note": "the side player 2's fighter faces, the same byte of its block"
   },
   "backdrop": {
    "addr": "0x101117",
    "type": "u8",
    "note": "the stage, which is the opponent's own: the number of player 2's or the computer's fighter, read again (the robot's recording of 2026-11-16: the same backdrop behind the same opponent on every screenshot). Picks the HD theme in \"hd\": \"stages\""
   },
   "time": {
    "addr": "0x1051B1",
    "type": "u8",
    "max": 99,
    "note": "timer, from 60 (the robot's recording of 2026-11-15: the number of five screenshots, one less at each second)"
   },
   "score": {
    "addr": "0x101048",
