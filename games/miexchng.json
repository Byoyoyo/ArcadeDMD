{
 "title": "Money Puzzle Exchanger",
 "match": [
  {
   "system": [
    "miexchng"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "miexchng"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "level": {
    "addr": "0x107546",
    "type": "u8",
    "note": "level of the solo game (FinalBurn Neo cheats and MAME 2003-Plus cheats, Select Level, to be confirmed in game)"
   },
   "max_chain": {
    "addr": "0x1030FB",
    "type": "u8",
    "note": "MAX CHAIN (FinalBurn Neo cheats and MAME 2003-Plus cheats, Select Max Chain Value)"
   },
   "chain": {
    "addr": "0x1030FD",
    "type": "u8",
    "note": "CHAIN, the chain in progress (FinalBurn Neo cheats and MAME 2003-Plus cheats, Select Chain Number)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   },
   "bios_mvs": {
    "addr": "0x10FD82",
    "type": "u8",
    "note": "BIOS_MVS_FLAG: 0 home console (AES, no coins), otherwise arcade (MVS)"
   }
  }
 },
 "hd": {
  "scene": "miexchng"
 },
 "demo": {
  "attract": true,
  "credits": 0,
  "p1_mode": 1,
  "p2_mode": 0,
  "level": 1,
  "chain": 0,
  "max_chain": 0,
  "score": 0,
  "sim": {
   "chain": {
    "cycle": [
     0,
     0,
     1,
     2,
     0,
     0,
     1,
     2,
     3,
     0
    ],
    "every": 1.2,
    "start": 2.0
   },
   "max_chain": {
    "cycle": [
     0,
     2,
     2,
     3,
     3,
     3,
     4
    ],
    "every": 5.0,
    "start": 4.0
   },
   "level": {
    "count": [
     1,
     30,
     1
    ],
    "every": 8.0,
    "start": 8.0
   }
  }
 },
 "scene": {
  "layers": [
   {
    "type": "sprite",
    "image": [
     "sprites/blocks.png"
    ],
    "frames": 6,
    "fps": 3,
    "mode": "fixed",
    "x": 0,
    "y": 27,
    "dim": 0.55,
    "when": {
     "not": {
      "all": [
       {
        "has": "p1_mode"
       },
       {
        "not": {
         "var": "p1_mode",
         "in": [
          1,
          2
         ]
        }
       },
       {
        "not": {
         "var": "p2_mode",
         "in": [
          1,
          2
         ]
        }
       }
      ]
     }
    }
   },
   {
    "type": "text",
    "font": "6x10",
    "x": 1,
    "y": 1,
    "align": "left",
    "segments": [
     {
      "text": "{score}",
      "color": "#ffa830"
     }
    ],
    "when": {
     "has": "score"
    },
    "flash": {
     "on": "score",
     "color": "#ffffff",
     "ms": 120
    }
   },
   {
    "type": "marquee",
    "font": "6x10",
    "y": 1,
    "x": 0,
    "w": 56,
    "speed": 12,
    "gap": 40,
    "upper": true,
    "segments": [
     {
      "text": "FACE",
      "color": "#1d5bff"
     },
     {
      "text": " - {title}",
      "color": "#ff60c0"
     }
    ],
    "when": {
     "not": {
      "has": "score"
     }
    }
   },
   {
    "type": "text",
    "font": "6x10",
    "x": 127,
    "y": 1,
    "align": "right",
    "segments": [
     {
      "text": "{score_p2}",
      "color": "#ffa830"
     }
    ],
    "when": {
     "all": [
      {
       "var": "p2_mode",
       "in": [
        1,
        2
       ]
      },
      {
       "has": "score_p2"
      }
     ]
    }
   },
   {
    "type": "text",
    "font": "6x10",
    "x": 127,
    "y": 1,
    "align": "right",
    "text": "INSERT COIN",
    "color": "#ffa830",
