   {
    "type": "cycle",
    "period": 1.5,
    "when": {
     "all": [
      {
       "not": {
        "var": "p2_mode",
        "in": [
         1,
         2
        ]
       }
      },
      {
       "var": "credits",
       "gt": 0
      }
     ]
    },
    "pages": [
