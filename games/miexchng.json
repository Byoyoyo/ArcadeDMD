    ]
   },
   {
    "type": "text",
    "font": "5x8",
    "x": 1,
    "y": 19,
    "align": "left",
    "segments": [
     {
      "text": "CHAIN ",
      "color": "#c080b0"
     },
     {
      "text": "{chain}",
      "color": "#ececec"
     }
    ],
    "when": {
