{
 "title": "2020 Super Baseball",
 "match": [
  {
   "system": [
    "2020bb",
    "2020bba",
    "2020bbh"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "2020bb",
   "2020bba",
   "2020bbh"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "time": {
    "addr": "0x104290",
    "type": "bcd",
    "bytes": 1,
    "note": "seconds of the game time (FinalBurn Neo cheats, Infinite Game Time, to be confirmed in game)"
   },
   "outs_total": {
    "addr": "0x1000C0",
    "type": "u8",
    "note": "outs counted in the game (FinalBurn Neo cheats, Infinite Total Outs, to be confirmed in game)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   }
  }
 },
 "hd": {
  "scene": "2020bb"
 },
 "demo": {
  "attract": true,
  "credits": 0,
  "p1_mode": 1,
  "p2_mode": 0,
  "time": 59,
  "outs_total": 0,
  "sim": {
   "time": {
    "count": [
     0,
     59,
     -1
    ],
    "every": 1.0,
    "start": 1.0
   },
   "outs_total": {
    "count": [
     0,
     27,
     1
    ],
    "every": 5.0,
    "start": 6.0
   }
  }
 },
