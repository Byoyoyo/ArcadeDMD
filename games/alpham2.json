{
 "title": "Alpha Mission II",
 "match": [
  {
   "system": [
    "alpham2",
    "alpham2p"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "alpham2",
   "alpham2p"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "lives": {
    "addr": "0x1010F2",
    "type": "u8",
    "note": "player 1 ships in reserve (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Lives PL1)"
   },
   "lives_p2": {
    "addr": "0x1011F2",
    "type": "u8",
    "note": "player 2 ships in reserve (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Lives PL2)"
   },
   "power": {
    "addr": "0x1010DD",
    "type": "u8",
    "max": 24,
    "note": "player 1 weapon power, 24 at most (FinalBurn Neo cheats and MAME 2003-Plus cheats, Weapon Power Up PL1)"
   },
   "gold": {
    "addr": "0x1010B0",
    "type": "bcd",
    "bytes": 2,
    "note": "player 1 gold, G= on the screen (FinalBurn Neo cheats, Infinite Gold PL1)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
