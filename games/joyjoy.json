{
 "title": "Puzzled",
 "match": [
  {
   "system": [
    "joyjoy"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "joyjoy"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "balloons": {
    "addr": "0x100904",
    "type": "u8",
    "note": "player 1 balloons left, L-BALL on the screen (FinalBurn Neo cheats and MAME 2003-Plus cheats, Max L-Ball PL1 writes 12, to be confirmed in game)"
   },
   "balloons_p2": {
    "addr": "0x100C14",
    "type": "u8",
    "note": "player 2 balloons left (FinalBurn Neo cheats and MAME 2003-Plus cheats, Max L-Ball PL2)"
   },
   "next": {
    "addr": "0x100673",
    "type": "u8",
    "note": "player 1 next piece: 0 red, 1 purple, 2 orange, 3 blue, 4 yellow, 5 green, 6 cyan (FinalBurn Neo cheats and MAME 2003-Plus cheats, Next shape always)"
   },
   "next_p2": {
    "addr": "0x100983",
    "type": "u8",
    "note": "player 2 next piece (FinalBurn Neo cheats and MAME 2003-Plus cheats)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
 "hd": {
  "scene": "joyjoy"
 },
 "demo": {
  "attract": true,
  "credits": 0,
  "p1_mode": 1,
  "p2_mode": 0,
  "score": 0,
  "balloons": 3,
  "next": 0,
  "sim": {
   "next": {
    "cycle": [
     0,
     1,
     2,
     3,
     4,
     5,
     6
    ],
    "every": 1.3,
    "start": 1.0
   },
   "balloons": {
    "cycle": [
     3,
     3,
     2,
     2,
     3
    ],
    "every": 9.0,
    "start": 10.0
   }
  }
 },
 "scene": {
  "layers": [
   {
    "type": "sprite",
    "image": [
     "sprites/blocks.png"
    ],
    "frames": 6,
    "fps": 3,
    "mode": "fixed",
    "x": 0,
    "y": 27,
    "dim": 0.55,
    "when": {
     "not": {
      "all": [
       {
        "has": "p1_mode"
       },
       {
        "not": {
         "var": "p1_mode",
         "in": [
          1,
          2
         ]
        }
       },
       {
        "not": {
         "var": "p2_mode",
         "in": [
          1,
          2
         ]
        }
       }
      ]
     }
    }
   },
   {
    "type": "text",
    "font": "6x10",
    "x": 1,
    "y": 1,
    "align": "left",
    "segments": [
     {
      "text": "{score}",
      "color": "#ffa830"
     }
    ],
    "when": {
     "has": "score"
    },
    "flash": {
     "on": "score",
     "color": "#ffffff",
     "ms": 120
    }
   },
   {
    "type": "marquee",
    "font": "6x10",
    "y": 1,
    "x": 0,
    "w": 70,
    "speed": 12,
    "gap": 40,
    "upper": true,
    "segments": [
     {
      "text": "SNK",
      "color": "#1d5bff"
     },
     {
      "text": " - {title}",
      "color": "#ffd040"
     }
    ],
    "when": {
     "not": {
      "has": "score"
     }
    }
   },
   {
    "type": "text",
    "font": "6x10",
    "x": 127,
    "y": 1,
    "align": "right",
    "segments": [
     {
      "text": "{score_p2}",
      "color": "#ffa830"
     }
    ],
    "when": {
     "all": [
      {
       "var": "p2_mode",
       "in": [
        1,
        2
       ]
      },
      {
       "has": "score_p2"
      }
     ]
    }
   },
   {
    "type": "text",
    "font": "6x10",
    "x": 127,
    "y": 1,
    "align": "right",
    "text": "INSERT COIN",
    "color": "#ffa830",
    "when": {
     "all": [
      {
       "not": {
        "var": "p2_mode",
        "in": [
         1,
         2
        ]
       }
      },
      {
       "not": {
        "var": "credits",
        "gt": 0
       }
      }
     ]
    },
    "blink_period": 1.0
   },
   {
    "type": "cycle",
    "period": 1.5,
    "when": {
     "all": [
      {
       "not": {
        "var": "p2_mode",
        "in": [
         1,
         2
        ]
       }
      },
      {
       "var": "credits",
       "gt": 0
      }
     ]
    },
    "pages": [
     {
      "layers": [
       {
        "type": "text",
        "font": "6x10",
        "x": 127,
        "y": 1,
        "align": "right",
        "text": "CREDITS {credits}",
        "color": "#ffa830"
       }
      ]
     },
     {
      "layers": [
       {
        "type": "text",
        "font": "6x10",
        "x": 127,
        "y": 1,
        "align": "right",
        "text": "PRESS START",
        "color": "#ffa830"
       }
      ]
     }
    ]
   },
   {
    "type": "rect",
    "x": 58,
    "y": 12,
    "w": 12,
    "h": 11,
    "color": "#201828",
    "when": {
     "all": [
      {
       "not": {
        "all": [
         {
          "has": "p1_mode"
         },
         {
          "not": {
           "var": "p1_mode",
           "in": [
            1,
            2
           ]
          }
         },
         {
          "not": {
           "var": "p2_mode",
           "in": [
            1,
            2
           ]
          }
         }
        ]
       }
      },
      {
       "has": "next"
      }
     ]
    }
   },
   {
    "type": "dot",
    "var": "next",
    "x": 64,
    "y": 17,
    "r": 4.0,
    "colors": [
     "#e63232",
     "#aa46d2",
     "#fa9628",
     "#325ae6",
     "#fadc28",
     "#3cc850",
     "#3cd2e6"
    ],
    "when": {
     "all": [
      {
       "not": {
        "all": [
         {
          "has": "p1_mode"
         },
         {
          "not": {
           "var": "p1_mode",
           "in": [
            1,
            2
           ]
          }
         },
         {
          "not": {
           "var": "p2_mode",
           "in": [
            1,
            2
           ]
          }
         }
        ]
       }
      },
      {
       "has": "next"
      }
     ]
    }
   },
   {
    "type": "icons",
    "var": "balloons",
    "x": 2,
    "y": 13,
    "max": 6,
    "gap": 1,
    "pattern": [
     ".##.",
     "####",
     "####",
     ".##.",
     "..#."
    ],
    "colors": {
     "#": "#f04678"
    },
    "when": {
     "all": [
      {
       "not": {
        "all": [
         {
          "has": "p1_mode"
         },
         {
          "not": {
           "var": "p1_mode",
           "in": [
            1,
            2
           ]
          }
         },
         {
          "not": {
           "var": "p2_mode",
           "in": [
            1,
            2
           ]
          }
         }
        ]
       }
      },
      {
       "has": "balloons"
      }
     ]
    },
    "flash": {
     "on": "balloons",
     "color": "#ffffff",
     "ms": 600
    }
   },
   {
    "type": "coinop",
    "when": {
     "all": [
      {
       "has": "p1_mode"
      },
      {
       "not": {
        "var": "p1_mode",
        "in": [
         1,
         2
        ]
       }
      },
      {
       "not": {
        "var": "p2_mode",
        "in": [
         1,
         2
        ]
       }
      }
     ]
    },
    "title": [
     {
      "text": "SNK",
      "color": "#1d5bff"
     },
     {
      "text": " - {title}",
      "color": "#ffd040"
     }
    ],
    "idle_image": [
     "sprites/insert_coin.gif",
     "sprites/insert_coin.png"
    ]
   }
  ]
 }
}
