 "memory": {
  "cpu": ":maincpu",
  "values": {
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   },
   "bios_mvs": {
    "addr": "0x10FD82",
    "type": "u8",
    "note": "BIOS_MVS_FLAG: 0 home console (AES, no coins), otherwise arcade (MVS)"
   }
  }
 },
 "demo": {
  "credits": 2,
  "score": 0
 },
 "scene": {
  "layers": [
   {
    "type": "sprite",
    "image": [
     "sprites/blocks.png"
    ],
    "frames": 6,
    "fps": 1.5,
    "mode": "fixed",
    "x": 0,
    "y": 27
   },
   {
    "type": "marquee",
    "segments": [
     {
      "text": "SNK",
      "color": "#1d5bff"
     },
     {
      "text": " - {title}",
      "color": "#e6e6e6"
     }
    ],
    "font": "6x10",
    "y": 0,
    "speed": 12,
    "gap": 40,
    "upper": true
   },
   {
    "type": "text",
    "font": "7x14",
    "x": 64,
    "y": 11,
    "align": "center",
    "segments": [
     {
      "text": "NEO",
      "color": "#ececec"
     },
     {
      "text": " GEO",
      "color": "#6f8cff"
     }
    ],
    "when": {
     "not": {
      "any": [
       {
        "has": "score"
       },
       {
        "has": "lives"
       },
       {
        "has": "credits"
       },
       {
        "has": "health"
       }
      ]
     }
    }
   },
   {
    "type": "text",
    "font": "7x14",
    "x": 64,
    "y": 8,
    "align": "center",
    "segments": [
     {
      "text": "CREDITS ",
      "color": "#30d8ff"
     },
     {
      "text": "{credits}",
      "color": "#ffc830"
     }
    ],
    "when": {
     "all": [
      {
       "has": "credits"
      },
      {
       "not": {
        "any": [
         {
          "has": "score"
         },
         {
          "has": "lives"
         },
         {
          "has": "health"
         }
        ]
       }
      }
     ]
    },
    "flash": {
     "on": "credits",
     "color": "#ffffff",
     "ms": 400
    }
   },
   {
    "type": "text",
    "font": "7x14",
    "x": 1,
    "y": 8,
    "align": "left",
    "text": "P1",
    "color": "#30ff60",
    "when": {
     "has": "score"
    }
   },
   {
    "type": "text",
    "font": "7x14",
    "x": 20,
    "y": 8,
    "align": "left",
    "text": "{score}",
    "color": "#ececec",
    "when": {
     "has": "score"
    },
    "flash": {
     "on": "score",
     "color": "#a8ffbc",
     "ms": 120
    }
   },
   {
    "type": "text",
    "font": "7x14",
    "x": 127,
    "y": 8,
    "align": "right",
    "segments": [
     {
      "text": "P2 ",
      "color": "#30d8ff"
     },
     {
      "text": "{score_p2}",
      "color": "#ffc830"
     }
    ],
    "when": {
     "has": "score_p2"
    },
    "flash": {
     "on": "score_p2",
     "color": "#fff4c8",
     "ms": 120
    }
   },
   {
    "type": "text",
    "font": "7x14",
    "x": 127,
    "y": 8,
    "align": "right",
    "segments": [
     {
      "text": "LIVES ",
      "color": "#30d8ff"
     },
     {
      "text": "{lives}",
      "color": "#ffc830"
     }
    ],
    "when": {
     "all": [
      {
       "has": "lives"
      },
      {
       "not": {
        "has": "score_p2"
       }
      }
     ]
    },
    "flash": {
     "on": "lives",
     "color": "#ff4040",
     "ms": 600
    }
   },
   {
    "type": "cycle",
    "period": 4,
    "when": {
     "not": {
      "has": "health"
     }
    },
    "pages": [
     {
      "when": {
       "has": "bombs"
      },
      "layers": [
       {
        "type": "text",
        "font": "6x10",
        "x": 64,
        "y": 19,
        "align": "center",
        "text": "BOMBS {bombs}",
        "color": "#30d8ff",
        "flash": {
         "on": "bombs",
         "color": "#ffffff",
         "ms": 300
        }
       }
      ]
     },
     {
      "when": {
       "all": [
        {
         "has": "credits"
        },
        {
         "any": [
          {
           "has": "score"
          },
          {
           "has": "lives"
          }
         ]
        }
       ]
      },
      "layers": [
       {
        "type": "text",
        "font": "6x10",
        "x": 64,
        "y": 19,
        "align": "center",
        "text": "CREDITS {credits}",
        "color": "#30d8ff",
        "flash": {
         "on": "credits",
         "color": "#ffffff",
         "ms": 400
        }
       }
      ]
     }
    ]
   }
  ]
 }
