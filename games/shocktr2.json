   "_hps": {
    "addr": "0x1023B4",
    "type": "u16s",
    "count": 93,
    "stride": 256,
    "note": "the energy of the game's objects, one word each and 256 bytes apart, at the place of the players' own in theirs (0x1001B4), as in Shock Troopers: the 93 objects from 0x102300 to 0x107F00. On recorded games the soldiers come with 50, a car and the tank a player rides with 100, the walkers and the tanks of mission 1 with 350 (437 for a tank of the second mission), and the boss of mission 1 is several objects: 500 for its first part, three guns of 300 and two turrets of 150 for the second, 500 again for the last. The HD scene shows the bar of an object that came with 150 or more once it has been hit three times, and during a boss the bar of each part being shot at"
   },
   "_boss": {
    "addr": "0x108F96",
    "type": "u16",
    "note": "the game's boss alarm: 0, then 0xFFFF from the image the game writes ALERT until the mission is over (a game recorded on 2026-11-18, mission 1: on at 153.8 s with ALERT on the screen, off at 244.2 s when MISSION SELECT comes)"
   },
   "_wait": {
    "addr": "0x108F78",
    "type": "u16",
    "note": "the timer stopped, PLEASE WAIT on the game's screen: 0xFFFF as a mission starts, during a dialogue, while the boss comes in, for a second when a soldier comes back after a life lost, and from the image a boss is destroyed until the next mission (a game recorded on 2026-11-18: on at 228.5 s, the image the last part of the truck fell)"
   },
   "_clear": {
    "addr": "0x108F80",
    "type": "u16",
    "note": "the STAGE CLEAR screen and the map after it: 0xFFFF from the count of the bonuses until the next mission starts (233.4 to 246.7 s, a game recorded on 2026-11-18)"
   },
   "_stage": {
    "addr": "0x108FC9",
    "type": "u8",
    "note": "the mission played, counted from 1: 1 as the first starts, 2 once the second is chosen on the map (a game recorded on 2026-11-18)"
   },
   "_mission": {
    "addr": "0x108F85",
    "type": "u8",
    "note": "the mission by the game's own number, times 4: 252 before the game, 0 in mission 1 (Goldoma City), 4 in the second on the route of Austin Air Base (a game recorded on 2026-11-18); the numbers of the other missions have not been seen"
   },
   "_area": {
    "addr": "0x10C52A",
    "type": "u8",
    "note": "the part of the mission being crossed: 1 to 4 then 5 for the boss's arena in mission 1, 7 then 8 as Austin Air Base starts (a game recorded on 2026-11-18)"
   },
