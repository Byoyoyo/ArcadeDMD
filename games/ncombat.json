  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "time": {
    "addr": "0x101818",
    "type": "u16",
    "note": "player 1 timer in frames, TIME in minutes and seconds (FinalBurn Neo cheats, Infinite Time PL1, to be confirmed in game)"
   },
   "lives": {
    "addr": "0x102402",
    "type": "u8",
    "note": "player 1 lives (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Lives PL1)"
   },
   "lives_p2": {
    "addr": "0x102403",
    "type": "u8",
    "note": "player 2 lives (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Lives PL2)"
   },
   "energy": {
    "addr": "0x100632",
    "type": "u8",
    "max": 32,
    "note": "player 1 LIFE, 32 when full (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Energy PL1)"
   },
   "energy_p2": {
    "addr": "0x100682",
    "type": "u8",
    "max": 32,
    "note": "player 2 LIFE (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Energy PL2)"
   },
   "power": {
    "addr": "0x10063B",
    "type": "u8",
    "max": 2,
    "note": "player 1 fire power, 0 to 2, POW on the screen (FinalBurn Neo cheats and MAME 2003-Plus cheats, Maximum Fire Power PL1)"
   },
   "char": {
    "addr": "0x10262E",
    "type": "u8",
    "note": "player 1 character (FinalBurn Neo cheats, Select Character PL1)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   }
  }
