   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "lives": {
    "addr": "0x101BA1",
    "type": "u8",
    "note": "player 1 lives (FinalBurn Neo cheats, Infinite Lives PL1)"
   },
   "lives_p2": {
    "addr": "0x101BA3",
    "type": "u8",
    "note": "player 2 lives (FinalBurn Neo cheats, Infinite Lives PL2)"
   },
   "power": {
    "addr": "0x101B79",
    "type": "u8",
    "max": 3,
    "note": "player 1 shot power, 0 to 3 (FinalBurn Neo cheats, Max Power PL1)"
   },
   "power_p2": {
    "addr": "0x101B7B",
    "type": "u8",
    "max": 3,
    "note": "player 2 shot power, 0 to 3 (FinalBurn Neo cheats, Max Power PL2)"
   },
   "round": {
    "addr": "0x101C87",
    "type": "u8",
    "add": 1,
    "note": "round, 0-based in RAM (FinalBurn Neo cheats, Select starting round)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
