    "addr": "0x106906",
    "type": "u16",
    "note": "timer in frames, TIME= in seconds (MAME 2003-Plus cheats, Infinite Time, to be confirmed in game)"
   },
   "lives": {
    "addr": "0x107000",
    "type": "u8",
    "note": "player 1 lives (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Lives PL1)"
   },
   "lives_p2": {
    "addr": "0x107400",
    "type": "u8",
    "note": "player 2 lives (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Lives PL2)"
   },
   "energy": {
    "addr": "0x107011",
    "type": "u8",
    "max": 5,
    "note": "player 1 hearts of LIFE (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Energy PL1, to be confirmed in game)"
   },
   "energy_p2": {
    "addr": "0x107411",
    "type": "u8",
    "max": 5,
    "note": "player 2 hearts (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Energy PL2)"
   },
   "money": {
    "addr": "0x107010",
    "type": "u8",
    "note": "player 1 flowers, the money of the game (FinalBurn Neo cheats and MAME 2003-Plus cheats, Get 255 Roses Now! PL1)"
   },
   "money_p2": {
    "addr": "0x107410",
    "type": "u8",
    "note": "player 2 flowers (FinalBurn Neo cheats and MAME 2003-Plus cheats, Get 255 Roses Now! PL2)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   }
  }
