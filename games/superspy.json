{
 "title": "The Super Spy",
 "match": [
  {
   "system": [
    "superspy"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "superspy"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "energy": {
    "addr": "0x10181F",
    "type": "u8",
    "max": 8,
    "note": "energy, 8 when full (FinalBurn Neo cheats, Infinite Energy)"
   },
   "weapon": {
    "addr": "0x101856",
    "type": "u8",
    "note": "weapon: 0 the pistol, 15 the machine gun (FinalBurn Neo cheats, Always have Machine Gun / Pistol)"
   },
   "ammo": {
    "addr": "0x1017F6",
    "type": "bcd",
    "bytes": 2,
    "note": "pistol bullets (FinalBurn Neo cheats, Infinite Pistol Ammo writes 999)"
   },
   "ammo_mg": {
    "addr": "0x101854",
    "type": "bcd",
    "bytes": 2,
    "note": "machine gun bullets (FinalBurn Neo cheats, Infinite M. Gun Ammo writes 999)"
   },
   "knife": {
    "addr": "0x101878",
    "type": "u8",
    "note": "strength of the knife (FinalBurn Neo cheats, Indestructible Knife writes 16, to be confirmed in game)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   },
   "bios_mvs": {
    "addr": "0x10FD82",
    "type": "u8",
    "note": "BIOS_MVS_FLAG: 0 home console (AES, no coins), otherwise arcade (MVS)"
   }
  }
 },
