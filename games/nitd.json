{
 "title": "Nightmare in the Dark",
 "match": [
  {
   "system": [
    "nitd",
    "nitdbl"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "nitd",
   "nitdbl"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "time": {
    "addr": "0x100002",
    "type": "u8",
    "note": "seconds of TIME (FinalBurn Neo cheats, Infinite Time writes 99)"
   },
   "lives": {
    "addr": "0x100055",
    "type": "u8",
    "note": "player 1 lives (FinalBurn Neo cheats, Infinite Lives PL1)"
   },
   "fire": {
    "addr": "0x100052",
    "type": "u8",
    "note": "player 1 fire power-up (FinalBurn Neo cheats, Always have Fire Power Up PL1)"
   },
   "speed": {
    "addr": "0x100051",
    "type": "u8",
    "note": "player 1 speed power-up (FinalBurn Neo cheats, Always have Speed Power Up PL1)"
   },
   "lives_p2": {
    "addr": "0x10028B",
    "type": "u8",
    "note": "player 2 lives (FinalBurn Neo cheats, Infinite Lives PL2)"
   },
   "boss": {
    "addr": "0x1029B7",
    "type": "u8",
    "note": "energy of the boss (FinalBurn Neo cheats, Kill Boss with 1 hit Now!, to be confirmed in game)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
