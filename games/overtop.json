  "cpu": ":maincpu",
  "values": {
   "time": {
    "addr": "0x10B004",
    "type": "bcd",
    "bytes": 1,
    "note": "time left (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Time)"
   },
   "rank": {
    "addr": "0x10E0FD",
    "type": "u8",
    "add": 1,
    "note": "rank in the race, 1 is first (FinalBurn Neo cheats and MAME 2003-Plus cheats, Always Finish 1st Place writes 0)"
   },
   "speed": {
    "addr": "0x104851",
    "type": "u8",
    "max": 255,
    "note": "speed, 255 at most (FinalBurn Neo cheats and MAME 2003-Plus cheats, Go at max speed)"
   },
   "lap_min": {
    "addr": "0x10E098",
    "type": "bcd",
    "bytes": 1,
    "note": "minutes of the lap time (FinalBurn Neo cheats and MAME 2003-Plus cheats, Lap time always = 0'00\"00)"
   },
   "lap_sec": {
    "addr": "0x10E099",
    "type": "bcd",
    "bytes": 1,
    "note": "seconds of the lap time (FinalBurn Neo cheats and MAME 2003-Plus cheats)"
   },
   "lap_cs": {
    "addr": "0x10E09A",
    "type": "bcd",
    "bytes": 1,
    "note": "hundredths of the lap time (FinalBurn Neo cheats and MAME 2003-Plus cheats)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
