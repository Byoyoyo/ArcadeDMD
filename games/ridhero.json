    "addr": "0x100F89",
    "type": "u8",
    "note": "position in the race, 1 for the first (MAME 2003-Plus cheats, Win every race (as 1st))"
   },
   "speed": {
    "addr": "0x100F52",
    "type": "bcd",
    "bytes": 2,
    "max": 199,
    "note": "speed of the bike, 199 at most (MAME 2003-Plus cheats, Always ride at Maximum Speed)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   },
   "bios_mvs": {
    "addr": "0x10FD82",
    "type": "u8",
    "note": "BIOS_MVS_FLAG: 0 home console (AES, no coins), otherwise arcade (MVS)"
   }
  }
 },
