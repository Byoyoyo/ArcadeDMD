{
 "title": "Puzzle De Pon!",
 "match": [
  {
   "system": [
    "puzzledp"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "puzzledp"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "score": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 1 score, not in the cheat databases: learn it with learn.bat (score=...)"
   },
   "score_p2": {
    "addr": "",
    "type": "bcd",
    "bytes": 4,
    "note": "player 2 score, learn it with learn.bat in a two-player game (score2=...)"
   },
   "p1_input": {
    "addr": "0x10FD96",
    "type": "u8",
    "note": "BIOS_P1CURRENT: player 1 stick and buttons, 1 up, 2 down, 4 left, 8 right, 16 A, 32 B, 64 C, 128 D (HD scene)"
   },
   "p2_input": {
    "addr": "0x10FD9C",
    "type": "u8",
    "note": "BIOS_P2CURRENT: player 2 stick and buttons, same bits (HD scene)"
   },
   "time": {
    "addr": "0x107D23",
    "type": "u8",
    "note": "time left of the solo game, the star dial (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Time (Solo))"
   },
   "level": {
    "addr": "0x1001E5",
    "type": "u8",
    "note": "level, LEVEL-{level+2} on the screen (FinalBurn Neo cheats and MAME 2003-Plus cheats, Level 39 when level ends, to be confirmed in game)"
   },
   "bubble": {
    "addr": "0x1023B5",
    "type": "u8",
    "note": "player 1 bubble in the launcher, 1 blue, 2 red, 3 orange... (FinalBurn Neo cheats and MAME 2003-Plus cheats, Current Bubble PL1)"
   },
   "bubble_next": {
    "addr": "0x10212B",
    "type": "u8",
    "note": "player 1 next bubble (FinalBurn Neo cheats and MAME 2003-Plus cheats, Next Bubble PL1)"
   },
   "bubble_p2": {
    "addr": "0x104B9D",
    "type": "u8",
    "note": "player 2 bubble in the launcher (FinalBurn Neo cheats, Current Bubble PL2)"
   },
   "bubble_next_p2": {
    "addr": "0x104913",
    "type": "u8",
    "note": "player 2 next bubble (FinalBurn Neo cheats, Next Bubble PL2)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   },
   "bios_request": {
    "addr": "0x10FDAE",
    "type": "u8",
    "note": "BIOS_USER_REQUEST: 2 demo, 3 title screen (asked by the BIOS when a coin goes in on an MVS)"
   },
   "bios_mode": {
    "addr": "0x10FDAF",
    "type": "u8",
    "note": "BIOS_USER_MODE: 1 title or demo, 2 game"
   },
   "bios_timer": {
    "addr": "0x10FDDA",
    "type": "bcd",
    "bytes": 1,
    "note": "BIOS_COMPULSION_TIMER: seconds left on the title screen before the game starts by itself"
   },
   "bios_mvs": {
    "addr": "0x10FD82",
    "type": "u8",
    "note": "BIOS_MVS_FLAG: 0 home console (AES, no coins), otherwise arcade (MVS)"
   }
  }
 },
