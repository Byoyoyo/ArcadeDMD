        "note": "score joueur 1, trouvé avec apprendre.bat (RetroArch, FinalBurn Neo)"
      },
      "lives": {
        "addr": "0x100377",
        "type": "u8",
        "add": -1,
        "min": 0,
        "note": "vies joueur 1, comme le 1UP de l'écran (le jeu compte aussi la vie en cours)"
      },
      "bombs": {
        "addr": "0x1004C0",
        "type": "u8",
        "note": "bombes joueur 1"
      },
      "ammo": {
        "addr": "0x1004C2",
        "type": "be",
        "bytes": 2,
        "note": "munitions joueur 1, sur 2 octets"
      },
      "weapon": {
        "addr": "0x1004B1",
        "type": "u8",
        "note": "arme joueur 1, 0 pistolet, 1 fusil à pompe, 2 lance-flammes, 3 lance-roquettes, 4 mitraillette"
      },
      "time": {
        "addr": "0x106E93",
        "type": "u8",
        "note": "chrono"
      },
      "credits": {
        "addr": "0xD00034",
        "type": "bcd",
        "bytes": 1,
        "note": "crédits MVS, lisibles dans MAME seulement"
      }
    }
  },
