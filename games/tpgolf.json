{
 "title": "Top Player's Golf",
 "match": [
  {
   "system": [
    "tpgolf"
   ]
  }
 ],
 "retroarch": {
  "content": [
   "tpgolf"
  ],
  "ram_base": "0x100000",
  "ram_size": "0x10000",
  "swap16": true,
  "note": "FinalBurn Neo core: Neo Geo 68000 RAM seen from 0x100000, bytes swapped within 16-bit words"
 },
 "memory": {
  "cpu": ":maincpu",
  "values": {
   "strokes": {
    "addr": "0x100106",
    "type": "u8",
    "note": "strokes on the hole, STROKE on the screen (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Strokes)"
   },
   "holes": {
    "addr": "0x10022C",
    "type": "u8",
    "note": "player 1 holes (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Holes PL1, to be confirmed in game)"
   },
   "time": {
    "addr": "0x10021B",
    "type": "u8",
    "note": "seconds left to play the stroke (FinalBurn Neo cheats and MAME 2003-Plus cheats, Infinite Time)"
   },
   "credits": {
    "addr": "0xD00034",
    "type": "bcd",
    "bytes": 1,
    "mame_only": true,
    "note": "MVS credits (backup RAM), readable in MAME only"
   },
   "p1_mode": {
    "addr": "0x10FDB6",
    "type": "u8",
    "note": "BIOS: player 1, 0 never played, 1 playing, 2 continue, 3 game over"
   },
   "p2_mode": {
    "addr": "0x10FDB7",
    "type": "u8",
    "note": "BIOS: player 2, same values"
   }
  }
 },
